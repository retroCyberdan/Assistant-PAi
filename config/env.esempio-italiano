# =====================================================================
#  Assistant-PAi: esempio di configurazione .env per l'italiano
#  Copia le righe del profilo scelto in ~/whisplay-ai-chatbot/.env
#  (le altre opzioni restano quelle di .env.template)
#  NON caricare mai su GitHub un file con le tue chiavi vere!
# =====================================================================

# ---------- PROFILO A: tutto OpenAI (il più semplice) ----------
ASR_SERVER=openai
LLM_SERVER=openai
TTS_SERVER=openai
OPENAI_API_KEY=sk-...la-tua-chiave...
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_ASR_MODEL="whisper-1"
OPENAI_VOICE_MODEL=tts-1
OPENAI_VOICE_TYPE=nova

# ---------- PROFILO B: Claude per le risposte, OpenAI per la voce ----------
# ASR_SERVER=openai
# LLM_SERVER=anthropic
# TTS_SERVER=openai
# OPENAI_API_KEY=sk-...la-tua-chiave...
# ANTHROPIC_API_KEY=sk-ant-...la-tua-chiave...
# ANTHROPIC_LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_MAX_TOKENS=1024
# OPENAI_VOICE_TYPE=nova

# ---------- PROFILO C: tutto Google Gemini ----------
# ASR_SERVER=gemini
# LLM_SERVER=gemini
# TTS_SERVER=gemini
# GEMINI_API_KEY=...la-tua-chiave...
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TTS_LANGUAGE_CODE=it-IT

# ---------- Comportamento (valido per tutti i profili) ----------
SYSTEM_PROMPT="Sei PAi, un assistente vocale simpatico e disponibile. Rispondi sempre in italiano, in modo breve e chiaro (massimo 3-4 frasi), senza elenchi puntati o formattazione Markdown."
CHAT_HISTORY_RESET_TIME=300
INITIAL_VOLUME_PERCENT=80

# ---------- Parola di attivazione (opzionale) ----------
# WAKE_WORD_ENABLED=true
# WAKE_WORDS=hey_jarvis
# WAKE_WORD_END_KEYWORDS=ciao ciao,basta,stop

# ---------- Interfaccia CYBERDECK (vedi cyberdeck/README.md) ----------
# Queste voci si modificano più comodamente dal pannello web http://pai.local:8080
# UI_STYLE: cyberdeck (v1.0), cyberdeck2 (v2.0, nuovo Rocky) oppure original
UI_STYLE=cyberdeck
DECK_NAME=CYBERDECK ROCKY Pi
DECK_NAME_KANA=サイバーデッキ ロッキー パイ
# DECK_PALETTE: verde, ambra oppure ghiaccio
DECK_PALETTE=verde
DECK_HINT=Tieni premuto il tasto e parla
# DECK_BOOT e DECK_SHUTDOWN: full, quick oppure off
DECK_BOOT=full
DECK_SHUTDOWN=full
DECK_SOUND=1
DECK_CRT=0.7
DECK_GLITCH=0.2
# DECK_LOGO_IMAGE=/home/pi/.config/cyberdeck/logo.png
